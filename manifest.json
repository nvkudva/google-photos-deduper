{
  "manifest_version": 3,
  "name": "Google Photos DeDuper",
  "version": "0.1.0",
  "description": "Scans your Google Photos library in the browser, finds visually duplicate photos, and moves the ones you pick to the bin.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://photos.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Google Photos DeDuper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/lib/selectors.js",
        "src/lib/store.js",
        "src/lib/hash.js",
        "src/lib/api.js",
        "src/lib/scanner.js",
        "src/lib/grouping.js",
        "src/ui/icons.js",
        "src/ui/styles.js",
        "src/ui/range.js",
        "src/ui/preview.js",
        "src/ui/results.js",
        "src/ui/panel.js",
        "src/content.js"
      ]
    }
  ]
}
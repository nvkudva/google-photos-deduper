{
  "manifest_version": 3,
  "name": "Photo DeDuper",
  "version": "1.0.0",
  "description": "Finds visually duplicate photos in your Google Photos library, in your browser, and bins the ones you pick.",
  "host_permissions": [
    "https://photos.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Photo DeDuper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/lib/store.js",
        "src/lib/hash.js",
        "src/lib/api.js",
        "src/lib/scanner.js",
        "src/lib/grouping.js",
        "src/ui/icons.js",
        "src/ui/styles.js",
        "src/ui/range.js",
        "src/ui/preview.js",
        "src/ui/results.js",
        "src/ui/panel.js",
        "src/ui/nav.js",
        "src/content.js",
        "src/dev-reload.js",
        "src/dev-shot.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
